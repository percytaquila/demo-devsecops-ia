# Copia este archivo a .env y rellena los valores. Nunca subas .env al repositorio.

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Contraseña de los 3 usuarios de prueba (alice, bruno, carla). Mínimo 8 caracteres.
DEMO_PASSWORD=

# Opcionales
PORT=3000
DB_PATH=./data/tienda.sqlite
# true si la app se sirve por HTTPS
COOKIE_SECURE=false
# true solo si hay un proxy inverso de confianza delante
TRUST_PROXY=false
